{
  "$schema": "https://btca.dev/btca.schema.json",
  "resources": [
    {
      "type": "git",
      "name": "swiftBook",
      "url": "https://github.com/apple/swift-book",
      "branch": "main",
      "specialNotes": "The Swift Programming Language book - official Swift documentation."
    },
    {
      "type": "git",
      "name": "whisperCpp",
      "url": "https://github.com/ggerganov/whisper.cpp",
      "branch": "master",
      "specialNotes": "Whisper.cpp - C/C++ port of OpenAI Whisper for local transcription."
    },
    {
      "type": "git",
      "name": "inferno",
      "url": "https://github.com/twostraws/Inferno",
      "branch": "main",
      "specialNotes": "Paul Hudson's SwiftUI Metal shaders - colorEffect, distortionEffect, layerEffect examples with stitchable syntax (iOS 17+)"
    },
    {
      "type": "git",
      "name": "swiftUIMetalExamples",
      "url": "https://github.com/aniket-bane/SwiftUI-Metal",
      "branch": "main",
      "specialNotes": "SwiftUI + Metal animated backgrounds including wave/sinebow shaders"
    },
    {
      "type": "git",
      "name": "ezaudio",
      "url": "https://github.com/syedhali/EZAudio",
      "branch": "master",
      "specialNotes": "iOS/macOS audio visualization framework using CALayers with GPU compositing - low-overhead real-time waveform rendering"
    },
    {
      "type": "git",
      "name": "dswaveform",
      "url": "https://github.com/dmrschmidt/DSWaveformImage",
      "branch": "main",
      "specialNotes": "Swift waveform rendering for iOS/macOS/visionOS - SwiftUI and UIKit implementations, WaveformAnalyzer for sample access"
    },
    {
      "type": "git",
      "name": "swiftuix",
      "url": "https://github.com/SwiftUIX/SwiftUIX",
      "branch": "master",
      "specialNotes": "Large SwiftUI extensions library - may have Canvas usage patterns and performance optimizations"
    }
  ],
  "model": "gpt-5.3-codex",
  "provider": "openai"
}